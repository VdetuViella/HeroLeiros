# Copia este archivo a .env.local. Sin DATABASE_URL la app funciona igual,
# pero sin cuentas: las partidas se guardan solo en el navegador.

# Postgres local de docker-compose.yml (puerto 54329 para no chocar con otro Postgres).
DATABASE_URL=postgres://heroleiros:heroleiros@127.0.0.1:54329/heroleiros

# Secreto para firmar las sesiones (mínimo 32 caracteres): `openssl rand -base64 32`.
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# URL pública de la app (la del servidor de desarrollo en local).
BETTER_AUTH_URL=http://127.0.0.1:43147

# Orígenes extra desde los que se permite iniciar sesión, separados por comas (opcional).
# AUTH_TRUSTED_ORIGINS=https://heroleiros.example.com
