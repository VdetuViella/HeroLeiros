# Copia este archivo a .env.local. Sin DATABASE_URL la app funciona igual,
# pero sin cuentas: las partidas se guardan solo en el navegador.

# --- Local (juego + cuentas) ---
# Postgres de docker-compose.yml (puerto 54329 para no chocar con otro Postgres).
DATABASE_URL=postgres://heroleiros:heroleiros@127.0.0.1:54329/heroleiros

# Secreto para firmar las sesiones (mínimo 32 caracteres): `openssl rand -base64 32`.
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# URL pública de la app (la del servidor de desarrollo en local).
BETTER_AUTH_URL=http://127.0.0.1:43147

# Orígenes extra desde los que se permite iniciar sesión, separados por comas (opcional).
# AUTH_TRUSTED_ORIGINS=https://heroleiros.example.com

# --- Producción (Vercel + Neon) ---
# 1. Crea un proyecto en Neon y copia la cadena *pooled* (acaba en -pooler…neon.tech).
# 2. En Vercel → Project → Settings → Environment Variables:
#    DATABASE_URL=postgres://USER:PASS@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#    BETTER_AUTH_SECRET=<openssl rand -base64 32>
#    BETTER_AUTH_URL=https://tu-app.vercel.app
# 3. Tras el primer deploy: `npx vercel env pull .env.local` (o exporta DATABASE_URL) y
#    `npm run db:migrate`. Opcional: `npm run db:seed` para las cuentas de demo.
# El juego (MIDI, carril, micrófono, partitura) no necesita estas variables.
